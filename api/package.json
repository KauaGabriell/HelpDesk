{
	"name": "api",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
		"db:bootstrap": "tsx prisma/bootstrap-admin.ts",
		"dev": "tsx --watch src/server.ts",
		"start": "node dist/server.js",
		"test": "dotenv -e .env.test -- node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
		"test:watch": "dotenv -e .env.test -- node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
		"test:db:reset": "dotenv -e .env.test -- prisma migrate reset --force"
	},
	"type": "module",
	"keywords": [],
	"author": "Kauã Gabriell",
	"license": "ISC",
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.2.0",
		"pg": "^8.21.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.1.0",
		"@types/node": "^25.9.1",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^7.2.1",
		"dotenv-cli": "^11.0.0",
		"esbuild": "^0.28.1",
		"jest": "^30.4.2",
		"prisma": "^7.8.0",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.11",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	}
}
